* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f8f9fa;
    color: #333;
    line-height: 1.6;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
}

header {
    background: #e5243b; /* Cor oficial do ODS 1 da ONU */
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

nav {
    background: #333;
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 12px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: #e5243b;
}

section {
    background: white;
    padding: 30px;
    margin: 20px 0;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

h2 {
    color: #e5243b;
    margin-bottom: 15px;
}

ul {
    margin-left: 20px;
    margin-top: 10px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 15px;
    margin-top: 15px;
}

.card {
    background: #f1f1f1;
    padding: 15px;
    border-left: 4px solid #e5243b;
    border-radius: 4px;
}

footer {
    text-align: center;
    padding: 20px;
    background: #222;
    color: #aaa;
    margin-top: 40px;
}
