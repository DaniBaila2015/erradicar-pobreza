:root {
--red: #ff4757;
--yellow: #ffa502;
--blue: #1e90ff;
--green: #2ed573;
--bg-main: #f0f3f8;
--text-dark: #2f3542;
--white: #ffffff;
--radius: 18px;
}
￼ {
margin: 0;
padding: 0;
box-sizing: border-box;
font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}
body {
background-color: var(--bg-main);
color: var(--text-dark);
line-height: 1.7;
}
/* Sublinhas decorativas */
.underline-red { border-bottom: 5px solid var(--red); border-radius: 4px; }
.underline-yellow { border-bottom: 5px solid var(--yellow); border-radius: 4px; }
.underline-blue { border-bottom: 5px solid var(--blue); border-radius: 4px; }
.underline-green { border-bottom: 5px solid var(--green); border-radius: 4px; }
/* Navbar de Abas */
.navbar {
background: rgba(255, 255, 255, 0.95);
backdrop-filter: blur(10px);
position: sticky;
top: 0;
z-index: 1000;
display: flex;
justify-content: space-between;
align-items: center;
padding: 15px 40px;
box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}
.logo {
font-size: 1.4rem;
font-weight: 800;
}
.logo-icon {
color: var(--red);
margin-right: 8px;
}
.nav-tabs {
display: flex;
list-style: none;
gap: 10px;
}
.tab-btn {
background: transparent;
border: none;
color: var(--text-dark);
font-weight: 700;
font-size: 0.95rem;
padding: 10px 20px;
border-radius: 30px;
cursor: pointer;
transition: all 0.3s ease;
}
.tab-btn:hover {
background: #e4e9f2;
}
.tab-btn.active {
background: var(--blue);
color: white;
}
.highlight-tab {
background: rgba(255, 71, 87, 0.1);
color: var(--red);
border: 2px dashed var(--red);
}
.highlight-tab.active {
background: var(--red);
color: white;
border-color: var(--red);
}
/* Sistema de Abas */
.tab-content {
display: none;
max-width: 1100px;
margin: 40px auto;
padding: 0 20px;
}
.tab-content.active-content {
display: block;
animation: fadeIn 0.4s ease;
}
@keyframes fadeIn {
from { opacity: 0; transform: translateY(10px); }
to { opacity: 1; transform: translateY(0); }
}
/* Hero */
.hero-box {
background: var(--white);
padding: 50px 30px;
border-radius: var(--radius);
text-align: center;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
.badge {
background: #ffeaa7;
color: #d63031;
font-weight: 800;
padding: 6px 16px;
border-radius: 20px;
font-size: 0.85rem;
}
.hero-box h1 {
font-size: 2.3rem;
margin: 20px 0;
line-height: 1.3;
}
.big-text {
font-size: 1.15rem;
max-width: 750px;
margin: 0 auto 30px;
color: #57606f;
}
.btn-main {
background: var(--red);
color: white;
border: none;
padding: 14px 30px;
border-radius: 30px;
font-weight: 800;
font-size: 1rem;
cursor: pointer;
box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
transition: transform 0.2s;
}
.btn-main:hover {
transform: scale(1.05);
}
.illustration-row {
display: flex;
gap: 20px;
margin-top: 30px;
}
.img-card {
flex: 1;
background: white;
padding: 12px;
border-radius: var(--radius);
text-align: center;
box-shadow: 0 5px 15px rgba(0,0,0,0.04);
}
.img-card img {
width: 100%;
height: 220px;
object-fit: cover;
border-radius: 12px;
}
.img-card p {
margin-top: 10px;
font-size: 0.95rem;
}
/* Secções */
.section-title {
text-align: center;
margin-bottom: 40px;
}
.section-title h2 {
font-size: 2.2rem;
margin-bottom: 10px;
}
.simple-cards-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
gap: 20px;
}
.card-simple {
background: white;
padding: 30px 20px;
border-radius: var(--radius);
text-align: center;
box-shadow: 0 5px 20px rgba(0,0,0,0.03);
}
.icon-circle {
width: 70px;
height: 70px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
margin: 0 auto 15px;
font-size: 1.8rem;
color: white;
}
.icon-circle.red { background: var(--red); }
.icon-circle.blue { background: var(--blue); }
.icon-circle.yellow { background: var(--yellow); }
.icon-circle.green { background: var(--green); }
/* Soluções */
.solutions-wrapper {
display: flex;
flex-direction: column;
gap: 25px;
}
.sol-card {
background: white;
display: flex;
border-radius: var(--radius);
overflow: hidden;
box-shadow: 0 5px 20px rgba(0,0,0,0.03);
}
.sol-card img {
width: 320px;
object-fit: cover;
}
.sol-info {
padding: 30px;
}
.sol-info h3 {
font-size: 1.4rem;
margin-bottom: 10px;
}
/* Espaço de Fala */
.talk-container {
max-width: 800px;
margin: 0 auto;
}
.talk-box {
background: white;
padding: 30px;
border-radius: var(--radius);
box-shadow: 0 8px 25px rgba(0,0,0,0.05);
margin-bottom: 40px;
}
.talk-box h3 {
margin-bottom: 20px;
color: var(--blue);
}
#commentForm {
display: flex;
flex-direction: column;
gap: 15px;
}
#commentForm input, #commentForm textarea {
padding: 14px;
border: 2px solid #e4e9f2;
border-radius: 12px;
font-size: 1rem;
outline: none;
}
#commentForm input:focus, #commentForm textarea:focus {
border-color: var(--blue);
}
.btn-send {
background: var(--green);
color: white;
border: none;
padding: 14px;
border-radius: 30px;
font-size: 1rem;
font-weight: 800;
cursor: pointer;
transition: background 0.3s;
}
.btn-send:hover {
background: #26af5f;
}
.comments-list {
display: flex;
flex-direction: column;
gap: 15px;
margin-top: 15px;
}
.comment-card {
background: white;
padding: 20px;
border-radius: 14px;
border-left: 5px solid var(--blue);
box-shadow: 0 4px 10px rgba(0,0,0,0.02);
}
.comment-header {
display: flex;
justify-content: space-between;
margin-bottom: 8px;
}
.comment-date {
font-size: 0.8rem;
color: #a4b0be;
}
.empty-notice {
text-align: center;
color: #a4b0be;
font-style: italic;
padding: 20px;
}
/* Rodapé */
footer {
text-align: center;
padding: 30px;
margin-top: 60px;
color: #a4b0be;
}
@media (max-width: 768px) {
.navbar { flex-direction: column; gap: 15px; }
.nav-tabs { flex-wrap: wrap; justify-content: center; }
.illustration-row { flex-direction: column; }
.sol-card { flex-direction: column; }
.sol-card img { width: 100%; height: 200px; }
}
