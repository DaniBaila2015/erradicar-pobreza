:root {
    --primary: #e5243b;
    --primary-dark: #b81427;
    --bg-dark: #0f172a;
    --bg-card: #1e293b;
    --bg-light: #f8fafc;
    --text-main: #334155;
    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #38bdf8;
    --radius: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', system-ui, sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-light);
    color: var(--text-main);
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.nav-brand {
    color: var(--text-light);
    font-size: 1.4rem;
    font-weight: 300;
}

.brand-icon {
    color: var(--primary);
    margin-right: 8px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
    align-items: center;
}

.nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--text-light);
}

.btn-nav {
    background: var(--primary);
    color: white !important;
    padding: 8px 18px;
    border-radius: 20px;
}

.btn-nav:hover {
    background: var(--primary-dark);
}

/* Hero */
.hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    color: var(--text-light);
    padding: 120px 20px 100px;
    text-align: center;
}

.badge-hero {
    background: rgba(229, 36, 59, 0.2);
    color: var(--primary);
    border: 1px solid var(--primary);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
}

.hero h1 {
    font-size: 3.2rem;
    margin: 25px 0;
    font-weight: 800;
    line-height: 1.2;
}

.highlight-text {
    color: var(--primary);
}

.hero p {
    max-width: 750px;
    margin: 0 auto 40px;
    font-size: 1.2rem;
    color: var(--text-muted);
}

.hero-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.btn-primary, .btn-secondary {
    padding: 14px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s, background 0.3s;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-primary:hover, .btn-secondary:hover {
    transform: translateY(-3px);
}

/* Stats */
.stats-section {
    padding: 80px 0;
    background: white;
}

.stats-header {
    text-align: center;
    margin-bottom: 50px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
}

.stat-card {
    background: var(--bg-light);
    padding: 30px;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid #e2e8f0;
}

.stat-icon {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 15px;
}

.stat-number {
    display: block;
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--bg-dark);
}

.stat-label {
    font-size: 0.95rem;
    color: var(--text-main);
    font-weight: 600;
}

.stat-sub {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* Dimensions */
.content-section {
    padding: 90px 0;
}

.content-section h2 {
    font-size: 2.2rem;
    text-align: center;
    margin-bottom: 15px;
}

.section-lead {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
    color: var(--text-muted);
}

.dimensions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.dim-card {
    background: white;
    padding: 30px;
    border-radius: var(--radius);
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
}

.dim-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.dim-header i {
    font-size: 1.8rem;
    color: var(--primary);
}

.dim-card ul {
    list-style: none;
}

.dim-card li {
    margin-bottom: 12px;
    font-size: 0.95rem;
    display: flex;
    gap: 10px;
    align-items: flex-start;
}

.dim-card li i {
    color: #10b981;
    margin-top: 4px;
}

/* Calculadora */
.interactive-section {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: 90px 0;
}

.calculator-wrapper {
    max-width: 850px;
    margin: 0 auto;
    background: var(--bg-card);
    padding: 40px;
    border-radius: var(--radius);
    border: 1px solid rgba(255,255,255,0.1);
}

.calculator-wrapper h2 {
    text-align: center;
    margin-bottom: 10px;
    color: var(--accent);
}

.calculator-wrapper p {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 30px;
}

.calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 15px;

    margin-bottom: 30px;
}

.checkbox-card {
    background: rgba(255, 255, 255, 0.05);
    padding: 15px 20px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: background 0.2s;
}

.checkbox-card:hover {
    background: rgba(255, 255, 255, 0.1);
}

.checkbox-card input {
    accent-color: var(--primary);
    width: 18px;
    height: 18px;
}

.calc-result {
    text-align: center;
    background: rgba(0,0,0,0.3);
    padding: 25px;
    border-radius: 8px;
    border-top: 3px solid var(--accent);
}

#scoreText {
    color: var(--accent);
    font-weight: 800;
}

/* ODS Grid */
.ods-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    margin-top: 40px;
}

.ods-card {
    background: white;
    padding: 30px;
    border-radius: var(--radius);
    border-left: 5px solid var(--primary);
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
}

.ods-number {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--primary);
    text-transform: uppercase;
}

.ods-card h3 {
    margin: 8px 0 12px;
}

/* Soluções Dark */
.dark-bg {
    background: #1e293b;
    color: white;
}

.solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.solution-item {
    text-align: center;
    padding: 20px;
}

.solution-item i {
    font-size: 2.5rem;
    color: var(--accent);
    margin-bottom: 20px;
}

.solution-item h3 {
    margin-bottom: 12px;
}

/* CTA */
.cta-section {
    padding: 90px 0;
    background: white;
}

.action-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.action-card {
    background: var(--bg-light);
    padding: 30px;
    border-radius: var(--radius);
    text-align: center;
    border: 1px solid #e2e8f0;
}

.action-card i {
    font-size: 2.2rem;
    color: var(--primary);
    margin-bottom: 15px;
}

/* Footer */
footer {
    background: var(--bg-dark);
    color: var(--text-muted);
    padding: 40px 0;
    text-align: center;
    font-size: 0.9rem;
    border-top: 1px solid rgba(255,255,255,0.05);
}

@media (max-width: 768px) {
    .nav-links { display: none; }
    .hero h1 { font-size: 2.2rem; }
}
